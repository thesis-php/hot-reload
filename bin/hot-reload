#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Thesis;

use Amp\Cancellation;
use Symfony\Component\Console\Attribute\Argument;
use Symfony\Component\Console\Attribute\Option;
use Symfony\Component\Console\SingleCommandApplication;
use Thesis\HotReload\Files;
use Thesis\HotReload\Internal\TtyProcess;

(static function (): void {
    $autoloaders = array_filter([
        /** @phpstan-ignore nullCoalesce.variable */
        $_composer_autoload_path ?? null,
        __DIR__ . '/../vendor/autoload.php',
        __DIR__ . '/../../../autoload.php',
    ]);

    if (array_any($autoloaders, fn($autoloader) => (bool) @include_once $autoloader)) {
        return;
    }

    fwrite(STDERR, "autoload.php not found. Tried:\n" . implode("\n", array_map(
        static fn($path) => "  - {$path}",
        $autoloaders,
    )) . "\n");

    exit(1);
})();

new class extends SingleCommandApplication {
    /**
     * @param non-empty-list<non-empty-string> $cmd
     * @param non-empty-list<string> $paths
     * @param ?non-empty-list<string> $extensions
     * @param list<string> $excludes
     * @return non-negative-int
     */
    public function __invoke(
        #[Argument(description: 'Command to run')]
        array $cmd,
        #[Option(description: 'Paths to watch', name: 'path')]
        array $paths = ['src'],
        #[Option(description: 'Extensions to watch (if none, all are watched)', name: 'ext')]
        ?array $extensions = null,
        #[Option(description: 'Patterns to exclude (e.g. *.generated.php)', name: 'exclude')]
        array $excludes = [],
        #[Option(description: 'Debounce delay in seconds')]
        float $debounce = 0.1,
        #[Option(description: 'Termination timeout in seconds')]
        float $terminationTimeout = 10,
    ): int {
        return hotReload(
            files: new Files(
                paths: $paths,
                extensions: $extensions,
                excludes: $excludes,
            ),
            process: static fn(Cancellation $termination) => TtyProcess::start(
                command: $cmd,
                termination: $termination,
                terminationTimeout: $terminationTimeout,
            ),
            debounce: $debounce,
        );
    }
}->run();
