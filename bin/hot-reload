#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Thesis;

use Amp\Cancellation;
use Amp\CancelledException;
use Amp\SignalCancellation;
use Amp\SignalException;
use Symfony\Component\Console\Attribute\Argument;
use Symfony\Component\Console\Attribute\Option;
use Symfony\Component\Console\SingleCommandApplication;
use Thesis\HotReload\Files;
use Thesis\HotReload\TransparentProcess;

(static function (): void {
    $autoloaders = array_filter([
        /** @phpstan-ignore nullCoalesce.variable */
        $_composer_autoload_path ?? null,
        __DIR__ . '/../vendor/autoload.php',
        __DIR__ . '/../../../autoload.php',
    ]);

    if (array_any($autoloaders, fn($autoloader) => (bool) @include_once $autoloader)) {
        return;
    }

    fwrite(STDERR, "autoload.php not found. Tried:\n" . implode("\n", array_map(
        static fn($path) => "  - {$path}",
        $autoloaders,
    )) . "\n");

    exit(1);
})();

new class extends SingleCommandApplication {
    /**
     * @param non-empty-list<non-empty-string> $cmd
     * @param non-empty-list<string> $paths
     * @param ?non-empty-list<string> $extensions
     * @param list<string> $excludes
     * @param list<string> $forwardSignals
     * @return non-negative-int
     */
    public function __invoke(
        #[Argument(description: 'Command to run')]
        array $cmd,
        #[Option(description: 'Paths to watch', name: 'path')]
        array $paths = ['src'],
        #[Option(description: 'Extensions to watch (if none, all are watched)', name: 'ext')]
        ?array $extensions = null,
        #[Option(description: 'Patterns to exclude (e.g. *.generated.php)', name: 'exclude')]
        array $excludes = [],
        #[Option(description: 'Debounce delay in seconds')]
        float $debounce = 0.1,
        #[Option(description: 'Termination timeout in seconds')]
        float $termTimeout = 3,
        #[Option(description: 'Signals to forward to the process (e.g. SIGUSR1 or 10)', name: 'forward-signal')]
        array $forwardSignals = [],
    ): int {
        $forwardSignals = self::resolveSignals($forwardSignals);

        try {
            return hotReload(
                files: new Files(
                    paths: $paths,
                    extensions: $extensions,
                    excludes: $excludes,
                ),
                task: static fn(Cancellation $termination) => TransparentProcess::start(
                    command: $cmd,
                    termination: $termination,
                    terminationTimeout: $termTimeout,
                    forwardSignals: $forwardSignals,
                ),
                debounce: $debounce,
                cancellation: new SignalCancellation([SIGINT, SIGTERM]),
            );
        } catch (CancelledException $exception) {
            $previous = $exception->getPrevious();

            if ($previous instanceof SignalException) {
                return self::SUCCESS;
            }

            throw $exception;
        }
    }

    /**
     * @param list<string> $names
     * @return list<int>
     */
    private static function resolveSignals(array $names): array
    {
        return array_map(
            static function (string $name) {
                if (preg_match('/^\d+$/', $name) === 1) {
                    return (int) $name;
                }

                $signal = @\constant($name);

                if (!\is_int($signal)) {
                    throw new \InvalidArgumentException("Invalid signal `{$name}`");
                }

                return $signal;
            },
            $names,
        );
    }
}->run();
