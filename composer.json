{
    "name": "thesis/hot-reload",
    "description": "Thesis Hot Reload",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "kafkiansky",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesis-php/people"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "amphp/amp": "^3.0",
        "amphp/byte-stream": "^2.1",
        "revolt/event-loop": "^1.0",
        "symfony/console": "^8.0",
        "thesis/exceptionally": "^0.3.0"
    },
    "require-dev": {
        "amphp/http-server": "^3.4",
        "amphp/log": "^2.0",
        "phpunit/phpunit": "^12.4",
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\": "src/"
        },
        "files": [
            "src/HotReload/Internal/debounce.php",
            "src/hotReload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\": "tests/"
        }
    },
    "bin": [
        "bin/hot-reload"
    ],
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
